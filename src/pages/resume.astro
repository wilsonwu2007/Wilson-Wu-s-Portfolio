---
import Layout from "../layouts/Layout.astro";

const resumeHref = `${import.meta.env.BASE_URL}resume/Wilson-Wu-Resume.pdf`;
---

<Layout title="Resume | Wilson Wu" description="Wilson Wu's resume.">
	<div class="resume-header">
		<h1>Resume</h1>
		<a class="download-button" href={resumeHref} download>Download PDF</a>
	</div>

	<div class="pdf-frame">
		<embed src={resumeHref} type="application/pdf" />
		<p class="muted fallback">
			Your browser may not display PDFs inline. <a href={resumeHref}>Open the PDF directly</a>.
		</p>
	</div>

	<style>
		.resume-header {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 1rem;
			margin-bottom: 1.5rem;
		}

		h1 {
			font-size: 1.9rem;
			margin: 0;
		}

		.download-button {
			display: inline-block;
			padding: 0.5rem 1rem;
			border: 1px solid var(--color-border);
			border-radius: 8px;
			font-size: 0.9rem;
			color: var(--color-text);
		}

		.download-button:hover {
			border-color: var(--color-accent);
			color: var(--color-accent);
			text-decoration: none;
		}

		.pdf-frame embed {
			width: 100%;
			height: 85vh;
			border: 1px solid var(--color-border);
			border-radius: 8px;
		}

		.fallback {
			margin-top: 0.75rem;
			font-size: 0.9rem;
		}
	</style>
</Layout>
