---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const projects = await getCollection("projects");
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} — Wilson Wu`} description={project.data.summary}>
	<a class="back-link" href={`${import.meta.env.BASE_URL}projects/`}>&larr; All projects</a>

	<article>
		<header class="project-header">
			<h1>{project.data.title}</h1>
			{project.data.org && <p class="muted org">{project.data.org}</p>}
			{project.data.tags.length > 0 && (
				<div class="tags">
					{project.data.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)}
		</header>

		<div class="prose">
			<Content />
		</div>
	</article>

	<style>
		.back-link {
			display: inline-block;
			margin-bottom: 2rem;
			font-size: 0.9rem;
			color: var(--color-text-muted);
		}

		.project-header {
			margin-bottom: 2rem;
			padding-bottom: 1.5rem;
			border-bottom: 1px solid var(--color-border);
		}

		.project-header h1 {
			font-size: 1.8rem;
			margin-bottom: 0.35rem;
		}

		.org {
			margin-bottom: 0.75rem;
		}

		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}

		.tag {
			font-size: 0.75rem;
			color: var(--color-text-muted);
			background: #f4f4f4;
			padding: 0.15rem 0.55rem;
			border-radius: 6px;
		}

		.prose :global(h2) {
			font-size: 1.25rem;
			margin-top: 2rem;
		}

		.prose :global(h3) {
			font-size: 1.05rem;
			margin-top: 1.5rem;
		}

		.prose :global(p),
		.prose :global(li) {
			color: var(--color-text);
		}

		.prose :global(ul) {
			margin-bottom: 1em;
		}

		.prose :global(img) {
			width: 100%;
			border-radius: 8px;
			border: 1px solid var(--color-border);
			margin: 1.25rem 0;
		}

		.prose :global(em) {
			color: var(--color-text-muted);
		}
	</style>
</Layout>
