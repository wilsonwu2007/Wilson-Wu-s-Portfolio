---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Projects — Wilson Wu" description="Selected engineering projects by Wilson Wu.">
	<h1>Projects</h1>
	<p class="muted intro-text">
		A selection of hardware, embedded systems, and research projects I've worked on.
	</p>

	<ul class="project-list">
		{
			projects.map((project) => (
				<li>
					<a class="project-card" href={`${import.meta.env.BASE_URL}projects/${project.id}/`}>
						{project.data.image && (
							<img
								class="thumb"
								src={`${import.meta.env.BASE_URL}${project.data.image.replace(/^\//, "")}`}
								alt=""
								loading="lazy"
							/>
						)}
						<div class="card-body">
							<div class="project-card-header">
								<h2>{project.data.title}</h2>
								{project.data.org && <span class="muted org">{project.data.org}</span>}
							</div>
							<p class="muted">{project.data.summary}</p>
							{project.data.tags.length > 0 && (
								<div class="tags">
									{project.data.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</div>
					</a>
				</li>
			))
		}
	</ul>

	<style>
		h1 {
			font-size: 1.9rem;
			margin-bottom: 0.4rem;
		}

		.intro-text {
			margin-bottom: 2.5rem;
		}

		.project-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
		}

		.project-card {
			display: flex;
			gap: 1.25rem;
			align-items: flex-start;
			padding: 1.25rem 1.5rem;
			border: 1px solid var(--color-border);
			border-radius: 10px;
			color: var(--color-text);
			transition: border-color 0.15s ease;
		}

		.project-card:hover {
			border-color: var(--color-accent);
			text-decoration: none;
		}

		.thumb {
			width: 96px;
			height: 96px;
			object-fit: cover;
			border-radius: 8px;
			flex-shrink: 0;
			border: 1px solid var(--color-border);
		}

		.card-body {
			min-width: 0;
		}

		@media (max-width: 560px) {
			.project-card {
				flex-direction: column;
			}

			.thumb {
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
			}
		}

		.project-card-header {
			display: flex;
			flex-wrap: wrap;
			align-items: baseline;
			gap: 0.5rem;
			margin-bottom: 0.35rem;
		}

		.project-card-header h2 {
			margin: 0;
			font-size: 1.1rem;
		}

		.org {
			font-size: 0.85rem;
		}

		.project-card p {
			margin-bottom: 0.5rem;
		}

		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem;
		}

		.tag {
			font-size: 0.75rem;
			color: var(--color-text-muted);
			background: #f4f4f4;
			padding: 0.15rem 0.55rem;
			border-radius: 6px;
		}
	</style>
</Layout>
